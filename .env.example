# Template for chat_agentv3.py config. Copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored so your secrets are never committed.

# NLB patch monitor (run over SSH on demand)
SSH_HOST=user@host
MONITOR_SCRIPT=/path/to/nlb_patch_monitor.sh
NLB_CASE=000000000000000
NLB_SR_ACCOUNT=000000000000

# Slack workflow-trigger webhook for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/triggers/XXXX/YYYY/ZZZZ

# Ollama backend + model
OLLAMA_HOST=http://<backend-or-alb>:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Teams agent display name
AGENT_NAME=Your AI Agent
