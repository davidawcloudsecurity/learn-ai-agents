# Template for chat_agentv3.py config. Copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored so your secrets are never committed.

# NLB patch monitor (run over SSH on demand)
SSH_HOST=user@host
MONITOR_SCRIPT=/path/to/nlb_patch_monitor.sh
NLB_SR_ACCOUNT=000000000000
# One SR case per OS (shared SR account above). Set both for a Windows+RHEL
# session; the agent reports each fleet separately or together.
NLB_CASE_WINDOWS=000000000000000
NLB_CASE_RHEL=000000000000000
# Legacy single-case fallback (used only if neither OS case above is set).
NLB_CASE=000000000000000

# Human pager (run over SSH when someone asks for a real person / escalation).
# Interface: <PAGER_SCRIPT> <caseId> --to <alias,...> [--region r] [--details t]
PAGER_SCRIPT=/path/to/nlb_patch_pager.sh
PAGER_TO=alias1
PAGER_REGION=ap-southeast-1
# Case to page with when the request names none (blank = use the Windows case).
PAGER_CASE=

# Slack workflow-trigger webhook for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/triggers/XXXX/YYYY/ZZZZ

# Amazon Bedrock backend (chat_agentv3.2.py). Auth via Bedrock API key
# (bearer token) — generate in the Bedrock console under "API keys".
BEDROCK_API_KEY=your-bedrock-api-key
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_MAX_TOKENS=1024

# Legacy Ollama backend + model (used by older chat_agent*.py)
OLLAMA_HOST=http://<backend-or-alb>:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Teams agent display name
AGENT_NAME=Your AI Agent

# How often (seconds) the --converse agent proactively posts a patch-status
# update to the Teams chat. Default 1800 = 30 minutes. Lower for testing.
STATUS_BROADCAST_INTERVAL=1800

# Default timezone for the get_time tool (named IANA zone or UTC offset).
DEFAULT_TZ=Asia/Singapore

# Where the app writes its logs (app.log + error.log). Defaults to a "logs"
# folder next to the script. Both files rotate (~2MB x 5 backups).
LOG_DIR=logs
