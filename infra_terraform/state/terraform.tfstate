            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/sda1",
                "encrypted": true,
                "iops": 3000,
                "kms_key_id": "arn:aws:kms:us-east-1:762595429056:key/c27eef24-e913-4286-926b-6532a922452b",
                "tags": {},
                "tags_all": {},
                "throughput": 125,
                "volume_id": "vol-0642fae1a6024de5b",
